{
  "name": "virtual-webauthn-authenticator",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev",
    "start": "nx run-many -t start",
    "lint": "nx run-many -t lint",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:coverage": "vitest run --coverage --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "vitest run --coverage --config vitest.integration.config.ts",
    "test:ui": "vitest --ui",
    "format": "prettier --write \"**/*.{ts,tsx,md}\" --check-ignore-pragma",
    "format:check": "nx run-many -t format:check",
    "check-types": "nx run-many -t check-types",
    "coverage:latex": "./scripts/generate_latex_coverage.ts coverage/coverage-final.json",
    "docs:toc": "tsx ./scripts/generate_readme_toc.ts",
    "release": "nx release",
    "openapi:latex": "./scripts/generate_latex_openapi.ts packages/contract/generated/openapi.json",
    "claude": "./scripts/claude.sh",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.4",
    "barrelsby": "^2.8.1",
    "copyfiles": "^2.4.1",
    "ejs": "^3.1.10",
    "eslint": "^9.34.0",
    "npm-run-all": "^4.1.5",
    "@nx/js": "23.1.0",
    "nx": "^23.1.0",
    "prettier": "^3.6.2",
    "skott": "^0.35.11",
    "tsx": "^4.20.6",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=18"
  }
}
